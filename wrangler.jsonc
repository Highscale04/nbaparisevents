{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nbaparisevents",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nbaparisevents"
    }
  ],
  "vars": {
    "SITE_URL": "https://www.nbaeventsparis.com",
    "NEXT_PUBLIC_SITE_URL": "https://www.nbaeventsparis.com",
    "MAIL_FROM": "NBA Official <mail@nbaeventsparis.com>",
    "CONTACT_EMAIL": "mail@nbaeventsparis.com",
    "ANNULATION_EMAIL": "jvelasseur552@gmail.com"
  },
  "routes": [
    { "pattern": "nbaeventsparis.com", "custom_domain": true },
    { "pattern": "www.nbaeventsparis.com", "custom_domain": true }
  ]
}
