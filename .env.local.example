# Même branchement que les autres billetteries (FFF, etc.).
# Les vraies valeurs restent dans .env.local et dans Netlify. Ne pas les committer.

WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_PAYMENT_METHOD=faldridge
WC_CHECKOUT_PATH=commander

FALDRIDGE_SECRET_KEY=
FALDRIDGE_PUBLISHABLE_KEY=
FALDRIDGE_CHECKOUT_ORIGIN=
FALDRIDGE_WEBHOOK_SECRET=

SITE_URL=https://www.nbaeventsparis.com
NEXT_PUBLIC_SITE_URL=https://www.nbaeventsparis.com

# E-mails de confirmation (Brevo). MAIL_FROM = expéditeur validé.
BREVO_API_KEY=
MAIL_FROM=NBA Official <mail@nbaeventsparis.com>
CONTACT_EMAIL=mail@nbaeventsparis.com

# Webhook à déclarer dans Faldridge :
# https://www.nbaeventsparis.com/api/webhooks/faldridge
